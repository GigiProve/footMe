{
  "name": "prolink",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-export-default-from": "^7.27.1",
    "eslint": "^8.57.1"
  },
  "scripts": {
    "start": "npm run start:mobile",
    "start:mobile": "npm run start --workspace @prolink/mobile",
    "start:mobile:clear": "npm run start:clear --workspace @prolink/mobile",
    "start:mobile:ios-sim": "npm run start:ios-sim --workspace @prolink/mobile",
    "start:mobile:tunnel": "npm run start:tunnel --workspace @prolink/mobile",
    "supabase": "npx -y supabase",
    "supabase:link": "npx -y supabase link --project-ref gwvkjbiuetjltrpugdxo",
    "supabase:db:push": "npx -y supabase db push",
    "supabase:db:reset": "npx -y supabase db reset",
    "supabase:migration:list": "npx -y supabase migration list",
    "dev:mobile": "npm run dev --workspace @prolink/mobile",
    "ios": "npm run ios --workspace @prolink/mobile",
    "android": "npm run android --workspace @prolink/mobile",
    "lint": "npm run lint:mobile",
    "lint:mobile": "npm run lint --workspace @prolink/mobile",
    "typecheck": "npm run typecheck:mobile",
    "typecheck:mobile": "npm run typecheck --workspace @prolink/mobile",
    "test": "npm run test:mobile",
    "test:mobile": "npm run test --workspace @prolink/mobile"
  }
}

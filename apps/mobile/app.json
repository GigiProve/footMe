{
  "expo": {
    "name": "footMe",
    "slug": "footme",
    "scheme": "footme",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "footMe usa la tua posizione per mostrarti le posizioni aperte vicino a te."
        }
      ]
    ],
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.footme.mobile"
    },
    "android": {
      "package": "com.footme.mobile"
    },
    "extra": {
      "projectName": "footMe"
    }
  }
}

{
  "name": "@prolink/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "../../scripts/run-node20.sh ../../node_modules/@expo/cli/build/bin/cli start",
    "start:clear": "../../scripts/run-node20.sh ../../node_modules/@expo/cli/build/bin/cli start --clear",
    "start:ios-sim": "open -a Simulator && ../../scripts/run-node20.sh ../../node_modules/@expo/cli/build/bin/cli start --clear --ios",
    "start:tunnel": "EXPO_UNSTABLE_TUNNEL_V2=1 ../../scripts/run-node20.sh ../../node_modules/@expo/cli/build/bin/cli start --clear --tunnel",
    "dev": "../../scripts/run-node20.sh ../../node_modules/@expo/cli/build/bin/cli start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "../../scripts/run-node20.sh ../../node_modules/eslint/bin/eslint.js .",
    "typecheck": "../../scripts/run-node20.sh typescript/bin/tsc --noEmit",
    "test": "../../scripts/run-node20.sh ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "../../scripts/run-node20.sh ../../node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/mulish": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.8",
    "expo": "^57.0.0",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/ws": "^8.5.13",
    "eslint-config-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18",
    "ws": "^8.18.0"
  }
}
